@model TdtLab5BT.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>

<h3>Bạn có chắc chắn muốn xóa sản phẩm này không?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Tên sản phẩm
        </dt>
        <dd class="col-sm-9">
            @Model.Name
        </dd>

        <dt class="col-sm-3">
            Ảnh sản phẩm
        </dt>
        <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="~/products/@Model.Image"
                     width="250"
                     height="180"
                     style="object-fit: cover;" />
            }
        </dd>

        <dt class="col-sm-3">
            Giá sản phẩm
        </dt>
        <dd class="col-sm-9">
            @Model.Price
        </dd>

        <dt class="col-sm-3">
            Giá khuyến mãi
        </dt>
        <dd class="col-sm-9">
            @Model.SalePrice
        </dd>

        <dt class="col-sm-3">
            Mô tả sản phẩm
        </dt>
        <dd class="col-sm-9">
            @Model.Description
        </dd>

        <dt class="col-sm-3">
            Danh mục
        </dt>
        <dd class="col-sm-9">
            @Model.CategoryId
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="Xóa sản phẩm"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Hủy
        </a>
    </form>
</div>