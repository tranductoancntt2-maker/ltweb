@model IEnumerable<Tdtbuoi7demo.Models.tdtMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TdtUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TdtPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TdtEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TdtPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                    @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.TdtUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TdtPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.TdtEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.TdtPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
