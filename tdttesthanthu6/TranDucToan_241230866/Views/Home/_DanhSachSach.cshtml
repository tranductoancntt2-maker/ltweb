@model IEnumerable<TranDucToan_241230866.Models.Sach>
<div class="grid">
    @foreach (var s in Model)
    {
        <div class="book-card">
            <a href="#">
                <img src="~/images/@s.Anh" alt="@s.TenSach" />
            </a>
        </div>
        <h2>@s.TenSach</h2>
        <div class="book-foot">
            <span class="price">@s.Gia</span>
            <button class="btn-buy">Thêm vào giỏ</button>
        </div>
    }
</div>
