@model IEnumerable<TranDucToan_241230866_De1.Models.LoaiTaiSan>
<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="~/images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a href="index.html">Trần Đức Toàn</a></li>
                @foreach(var lts in Model)
                {
                    <li>
                        <a href="/Home/LocTaiSan?maLoai=@lts.MaLoai" class="loc-tai-san" data-maloai="@lts.MaLoai" data-ten="@lts.TenLoai">
                            @lts.TenLoai
                        </a>
                    </li>
                }
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>
