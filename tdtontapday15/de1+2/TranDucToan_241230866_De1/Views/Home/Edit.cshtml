@model TranDucToan_241230866_De1.Models.TaiSan
@{
    ViewData["Title"] = "Sửa thông tin tài sản";
}
<main class="main">
    <div class="container">
        <div class="section-head">
            <h3>Sửa thông tin tài sản</h3>
            <a asp-action="Index"&lsaquo; Quay lại></a>
        </div>
        <form asp-action="Edit" asp-route-id="@Model.MaTs" method="post" class="form-box">
            <div asp-validation-summary="ModelOnly" class="text-error"></div>
            <input type="hidden" asp-for="MaTs" />
            <div class="form-row">
                <label asp-for="MaLoai">Loại tài sản</label>
                <select asp-for="MaLoai" asp-items="(SelectList)ViewBag.MaLoai"></select>
                <span asp-validation-for="MaLoai" class="text-error"></span>
            </div>
            <div class="form-row">
                <label asp-for="TenTs">Tên tài sản</label>
                <input asp-for="TenTs" ></input>
                <span asp-validation-for="TenTs" class="text-error"></span>
            </div>
            <div class="form-row">
                <label asp-for="NguyenGia">Nguyên giá (triệu)</label>
                <input asp-for="NguyenGia" type="number" step="1"></input>
                <span asp-validation-for="NguyenGia" class="text-error"></span>
            </div>
            <div class="form-row">
                <label asp-for="Anh">Tên file ảnh</label>
                <input asp-for="Anh"></input>
                <span asp-validation-for="Anh" class="text-error"></span>
            </div>
            <button type="submit" class="btn-buy">Save</button>
        </form>
    </div>
</main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}