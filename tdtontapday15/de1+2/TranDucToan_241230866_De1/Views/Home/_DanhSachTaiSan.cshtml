@model IEnumerable<TranDucToan_241230866_De1.Models.TaiSan>
<div class="grid">
    @foreach (var ts in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@ts.Anh" alt="@ts.TenTs" /></a>
            <h2>@ts.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@ts.NguyenGia</span>
                <a asp-action="Edit" asp-route-id="@ts.MaTs" class="btn-buy">Sửa</a>
            </div>
        </div>

    }


</div>