@model btbuoi2.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="product-detail">

    <h4>Chi tiết sản phẩm</h4>

    <div class="row">

        <div class="col-md-4">
            <img src="@Model.Image"
                 alt="@Model.Name"
                 class="detail-image" />
        </div>

        <div class="col-md-8">

            <h3>@Model.Name</h3>

            <p>
                <strong>ID:</strong>
                @Model.Id
            </p>

            <p>
                <strong>Giá:</strong>
                @Model.Price.ToString("N0") đ
            </p>

            <p>
                <strong>Ngày tạo:</strong>
                @Model.CreatedAt.ToString("dd-MM-yyyy")
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </div>

</div>
