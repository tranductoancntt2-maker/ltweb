        </div>
    </div>

    <div class="col-md-3">
        <div class="product">
            <img src="~/images/product1.webp" alt="Product Name 3" />
            <p>Product 3</p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="product">
            <img src="~/images/product1.webp" alt="Product Name 4" />
