@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<TdtTH2Lab4.Models.Student>

<div class="container-fluid px-4">
    <h1 class="mt-4">Danh sách sinh viên</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">Students</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Quản lý sinh viên
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-route="student_add" class="btn btn-primary">Create Student</a>
            </div>

            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Ảnh</th>
                        <th>Họ tên</th>
                        <th>Ngày sinh</th>
                        <th>Ngành</th>
                        <th>Giới tính</th>
                        <th>Hệ ĐT</th>
                        <th>Điểm</th>
                        <th>Địa chỉ</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.AvatarUrl))
                                {
                                    <img src="@s.AvatarUrl" alt="Avatar" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;" />
                                }
                                else
                                {
                                    <span>Chưa có ảnh</span>
                                }
                            </td>
                            <td>@s.Name</td>
                            <td>@(s.DateOfBorth?.ToString("dd/MM/yyyy"))</td>
                            @{
                                string str = "";
                                switch (s.Branch)
                                {
                                    case Branch.IT:
                                        str = "CNTT";
                                        break;
                                    case Branch.BE:
                                        str = "Kinh tế";
                                        break;
                                    case Branch.CE:
                                        str = "Công trình";
                                        break;
                                    case Branch.EE:
                                        str = "Điện - Điện tử";
                                        break;
                                }
                            }
                            <td>@str</td>
                            <td>@(s.Gender == Gender.Male ? "Nam" : (s.Gender == Gender.Female ? "Nữ" : ""))</td>
                            <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                            <td>@(s.Score?.ToString("0.0"))</td>
                            <td>@s.Address</td>
                            <td>@s.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style = "background-color: yellow;";
        }
    </script>
}
