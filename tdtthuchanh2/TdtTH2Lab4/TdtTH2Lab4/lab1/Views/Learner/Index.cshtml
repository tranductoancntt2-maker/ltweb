@{
    ViewData["Title"] = "Learner List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
@model IEnumerable<TdtTH2Lab4.Models.Learner>

<div class="container-fluid px-4">
    <h1 class="mt-4">Learner List</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">Learners</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách người học
        </div>
        <div class="card-body">
            <div class="mb-3">
                <a asp-action="Create" class="btn btn-primary">Create New Student</a>
            </div>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Tên</th>
                        <th>Họ</th>
                        <th>Ngành</th>
                        <th>Ngày Nhập Học</th>
                        <th>Chức năng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.LearnerID</td>
                            <td>@s.FirstMidName</td>
                            <td>@s.LastName</td>
                            <td>@s.Major?.MajorName</td>
                            <td>@s.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@s.LearnerID" class="btn btn-sm btn-outline-warning">Edit</a> |
                                <a asp-action="Delete" asp-route-id="@s.LearnerID" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
