@model IEnumerable<Student>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách sinh viên</h2>
    <a asp-route="student-add" class="btn btn-primary">+ Thêm sinh viên</a>
</div>

<div class="table-responsive">
<table class="table table-striped table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr><th>Mã</th><th>Họ tên</th><th>Ngày sinh</th><th>Ngành</th><th>Giới tính</th><th>Hệ đào tạo</th><th>Địa chỉ</th><th>Email</th></tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        var branchName = s.Branch switch
        {
            Branch.IT => "CNTT",
            Branch.BE => "Kinh tế",
            Branch.CE => "Công trình",
            Branch.EE => "Điện - Điện tử",
            _ => "Chưa xác định"
        };
        <tr>
            <td>@s.Id</td><td>@s.Name</td><td>@(s.DateOfBirth == DateTime.MinValue ? "" : s.DateOfBirth.ToString("dd/MM/yyyy"))</td>
            <td>@branchName</td><td>@(s.Gender == Gender.Male ? "Nam" : s.Gender == Gender.Female ? "Nữ" : "")</td>
            <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td><td>@s.Address</td><td>@s.Email</td>
        </tr>
    }
    </tbody>
</table>
</div>
