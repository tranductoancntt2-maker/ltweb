<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tdtbtlab3</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tdtbtlab3.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="top-menu">
            <div class="menu-container">

                <!-- LOGO -->
                <a class="menu-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    TDTBTLAB3
                </a>

                <!-- MENU -->
                <nav class="menu-nav">

                    <a asp-controller="Home" asp-action="Index">
                        Trang chủ
                    </a>

                    <a href="#">
                        Giới thiệu
                    </a>

                    <a href="#">
                        Liên hệ
                    </a>

                    <a href="#">
                        Sản phẩm
                    </a>

                </nav>

            </div>
        </div>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="my-footer">
        <div class="my-footer-container">

            <div class="my-footer-item">
                <h3>GIỚI THIỆU</h3>

                <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit.
                    Doloribus ex suscipit deserunt mollitia reiciendis, nobis
                    iure aliquam velit et laboriosam ducimus veritatis corporis est,
                    dolores aperiam! Officiis impedit provident.
                </p>
            </div>

            <div class="my-footer-item">
                <h3>LIÊN HỆ</h3>

                <p>
                    Lorem, ipsum dolor sit amet consectetur adipisicing elit.
                    Odio amet suscipit quasi quisquam impedit magni molestias.
                    Dolores, aliquid commodi iste eos voluptate nisi dolores
                    dolorem, repudiandae culpa aliquid.
                </p>
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
